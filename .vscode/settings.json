{
  // ── macOS 전용 터미널 환경 ────────────────────────────────────────────────
  // - Homebrew, Cargo를 PATH에 추가 (VS Code GUI 기동 시 login shell 미로드 대응)
  // - CARGO_TARGET_DIR: 외장 하드 ._* 메타파일 패닉 방지 (내부 드라이브로 리다이렉트)
  "terminal.integrated.env.osx": {
    "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:${env:HOME}/.cargo/bin:${env:PATH}",
    "CARGO_TARGET_DIR": "${env:HOME}/.cache/react-tauri-video-editor-target"
  },

  // ── Windows 전용 터미널 환경 ─────────────────────────────────────────────
  // - PATH: Cargo 바이너리 경로 추가 (VS Code GUI 기동 시 PATH 미로드 대응)
  // - CARGO_TARGET_DIR: 빌드 산출물을 내부 드라이브 캐시로 분리 (필수)
  "terminal.integrated.env.windows": {
    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}",
    "CARGO_TARGET_DIR": "${env:USERPROFILE}\\.cache\\react-tauri-video-editor-target"
  },

  // ── rust-analyzer: Cargo target 경로 강제 ──────────────────────────────
  // ⚠ rust-analyzer extraEnv는 ${env:VAR} 변수 치환을 지원하지 않는다.
  //   반드시 실제 절대 경로를 입력한다 (하드코딩 불가피).
  //   Windows 환경에서는 아래 경로를 본인 홈 디렉터리로 바꿔 사용한다.
  //   예) Windows: "C:\\Users\\<USERNAME>\\.cache\\react-tauri-video-editor-target\\rust-analyzer"
  //
  // macOS: cargo.targetDir=true 는 워크스페이스 target/rust-analyzer를 만들어
  //         exFAT에서 ._*.toml 메타파일을 재생성하므로 사용하지 않는다.
  "rust-analyzer.server.extraEnv": {
    "CARGO_TARGET_DIR": "/Users/jsjmac/.cache/react-tauri-video-editor-target/rust-analyzer"
  },
  "rust-analyzer.cargo.extraEnv": {
    "CARGO_TARGET_DIR": "/Users/jsjmac/.cache/react-tauri-video-editor-target/rust-analyzer"
  },
  "rust-analyzer.check.extraEnv": {
    "CARGO_TARGET_DIR": "/Users/jsjmac/.cache/react-tauri-video-editor-target/rust-analyzer"
  },

  // ── 외장 드라이브 ._* 파일 탐색기에서 숨기기 (macOS) ─────────────────────
  "files.exclude": {
    "**/.DS_Store": true,
    "**/._*": true,
    "**/.Spotlight-V100": true,
    "**/.Trashes": true,
    "**/.fseventsd": true
  },
  "search.exclude": {
    "**/._*": true,
    "src-tauri/target": true,
    "**/node_modules": true
  },

  // ── Windows 전용: 줄 끝 처리 ────────────────────────────────────────────
  // Rust/TOML/JSON 파일은 LF 강제 (CRLF 변환으로 인한 cargo 빌드 오류 방지)
  "[rust]": { "files.eol": "\n" },
  "[toml]": { "files.eol": "\n" },
  "[json]": { "files.eol": "\n" },
  "[jsonc]": { "files.eol": "\n" }
}
