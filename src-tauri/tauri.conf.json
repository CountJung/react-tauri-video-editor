{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Editor",
  "version": "0.1.0",
  "identifier": "com.videoeditor.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$VIDEO/**/*",
            "$AUDIO/**/*",
            "$PICTURE/**/*",
            "$DOCUMENT/**/*",
            "$DOWNLOAD/**/*",
            "$DESKTOP/**/*",
            "$TEMP/**/*",
            "$APPCACHE/**/*"
          ],
          "deny": [
            "$HOME/**/.*/**",
            "$HOME/**/.*",
            "$HOME/**/*.key",
            "$HOME/**/*.pem",
            "$HOME/**/*.p12",
            "$HOME/**/*.pfx"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
